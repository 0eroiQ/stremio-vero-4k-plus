[Unit]
Description=Stremio for Vero streaming service
Wants=network-online.target
Requires=stremio-vero-web.service
After=network-online.target stremio-vero-web.service

[Service]
Type=simple
User=osmc
Group=osmc
StateDirectory=stremio-vero
CacheDirectory=stremio-vero
WorkingDirectory=/usr/lib/stremio-vero/service
ExecStart=/usr/bin/python3 /usr/lib/stremio-vero/service-launcher.py
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/stremio-vero /var/cache/stremio-vero
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
