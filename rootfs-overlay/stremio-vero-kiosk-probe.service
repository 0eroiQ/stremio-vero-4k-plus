[Unit]
Description=Stremio for Vero disabled EGLFS kiosk compatibility probe
After=network.target stremio-vero-web.service
Wants=stremio-vero-web.service
ConditionPathExists=/usr/lib/qt5/bin/qmlscene
ConditionPathExists=/usr/share/stremio-vero/kiosk/main.qml
RefuseManualStart=yes

[Service]
Type=simple
User=osmc
Group=osmc
SupplementaryGroups=video input
ExecStart=/usr/bin/python3 /usr/lib/stremio-vero/kiosk-launcher.py
Restart=no
RuntimeDirectory=stremio-vero-kiosk
RuntimeDirectoryMode=0700
StateDirectory=stremio-vero-kiosk
StateDirectoryMode=0700
CacheDirectory=stremio-vero-kiosk
CacheDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
